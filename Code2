EDIT_HTML = """
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Entry</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; max-width: 900px; }
    form { padding: 20px; border: 1px solid #ddd; border-radius: 8px; }
    input[type="text"], textarea {
      width: 100%; padding: 10px; margin-top: 8px; margin-bottom: 16px;
      border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box;
    }
    textarea { min-height: 140px; }
    button {
      background: black; color: white; border: none; padding: 10px 16px;
      border-radius: 6px; cursor: pointer;
    }
    a { display: inline-block; margin-top: 16px; }
  </style>
</head>
<body>
  <h1>Edit Entry</h1>
  <form method="post">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label>Title</label>
    <input type="text" name="title" maxlength="200" value="{{ entry['title'] }}" required>

    <label>Tags</label>
    <input type="text" name="tags" maxlength="200" value="{{ entry['tags'] }}">

    <label>Content</label>
    <textarea name="content" maxlength="10000" required>{{ entry['content'] }}</textarea>

    <button type="submit">Update Entry</button>
  </form>
  <a href="/">← Back</a>
</body>
</html>
"""


def get_db_connection():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    with get_db_connection() as conn:
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS entries (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                tags TEXT,
                content TEXT NOT NULL
            )
            """
        )


def generate_csrf_token():
    import secrets
    from flask import session
    if "csrf_token" not in session:
        session["csrf_token"] = secrets.token_hex(32)
    return session["csrf_token"]


def validate_csrf():
    from flask import session
    token = request.form.get("csrf_token", "")
    if not token or token != session.get("csrf_token"):
        abort(403)


app.jinja_env.globals["csrf_token"] = generate_csrf_token


@app.route("/")
def index():
    query = request.args.get("q", "").strip()
    with get_db_connection() as conn:
        if query:
            like_query = f"%{query}%"
            entries = conn.execute(
                """
                SELECT * FROM entries
                WHERE title LIKE ? OR tags LIKE ? OR content LIKE ?
                ORDER BY id DESC
                """,
                (like_query, like_query, like_query),
            ).fetchall()
        else:
            entries = conn.execute("SELECT * FROM entries ORDER BY id DESC").fetchall()

    return render_template_string(HTML, entries=entries, query=query)


@app.route("/add", methods=["POST"])
def add_entry():
    validate_csrf()
    title = request.form["title"].strip()[:MAX_TITLE_LEN]
    tags = request.form.get("tags", "").strip()[:MAX_TAGS_LEN]
    content = request.form["content"].strip()[:MAX_CONTENT_LEN]

    with get_db_connection() as conn:
        conn.execute(
            "INSERT INTO entries (title, tags, content) VALUES (?, ?, ?)",
            (title, tags, content),
        )

    return redirect(url_for("index"))


@app.route("/edit/<int:entry_id>", methods=["GET", "POST"])
def edit_entry(entry_id):
    with get_db_connection() as conn:
        entry = conn.execute("SELECT * FROM entries WHERE id = ?", (entry_id,)).fetchone()

        if entry is None:
            abort(404)

        if request.method == "POST":
            validate_csrf()
            title = request.form["title"].strip()[:MAX_TITLE_LEN]
            tags = request.form.get("tags", "").strip()[:MAX_TAGS_LEN]
            content = request.form["content"].strip()[:MAX_CONTENT_LEN]

            conn.execute(
                "UPDATE entries SET title = ?, tags = ?, content = ? WHERE id = ?",
                (title, tags, content, entry_id),
            )
            return redirect(url_for("index"))

    return render_template_string(EDIT_HTML, entry=entry)


@app.route("/delete/<int:entry_id>", methods=["POST"])
def delete_entry(entry_id):
    validate_csrf()
    with get_db_connection() as conn:
        conn.execute("DELETE FROM entries WHERE id = ?", (entry_id,))
    return redirect(url_for("index"))


if __name__ == "__main__":
    init_db()
    app.run(debug=os.environ.get("FLASK_DEBUG", "false").lower() == "true")
